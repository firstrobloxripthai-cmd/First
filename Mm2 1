-- 🔫 [FIXED] ระบบตรวจจับปืนตกแบบเจาะจงทุกซอกมุม
-- ==========================================
local function UpdateGunDropESP()
    for _, obj in pairs(Workspace:GetDescendants()) do
        -- ตรวจหาทั้ง Part ชื่อ GunDrop หรือ Tool ชื่อ Gun ที่ถูกวางไว้บนพื้น
        local isGunDrop = (obj.Name == "GunDrop") or 
                          (obj:IsA("Tool") and obj.Name == "Gun" and not obj.Parent:FindFirstChildOfClass("Humanoid")) or
                          (obj:IsA("BasePart") and obj.Name == "Gun" and not obj.Parent:FindFirstChildOfClass("Humanoid"))
        
        if isGunDrop then
            local highlight = obj:FindFirstChild("Gun_Highlight")
            
            if ESPEnabled then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "Gun_Highlight"
                    highlight.Parent = obj
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                end
                
                -- ตั้งค่าสีออร่าปืนตกเป็น "สีเหลืองนีออนสว่าง" ทะลุกำแพง
                highlight.FillColor = Color3.fromRGB(255, 255, 0)
                highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                highlight.FillTransparency = 0.2
                highlight.OutlineTransparency = 0
                highlight.Enabled = true
            else
                if highlight then highlight.Enabled = false end
            end
        end
    end
end

local function UpdateAllESP()
    UpdatePlayerESP()
    UpdateGunDropESP()
end

local function GetDroppedGun()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if (obj.Name == "GunDrop") or 
           (obj:IsA("Tool") and obj.Name == "Gun" and not obj.Parent:FindFirstChildOfClass("Humanoid")) then
            return obj
        end
    end
    return nil
end

local function TeleportToGun()
    if IsTeleporting then return end
    local gun = GetDroppedGun()
    local char = LocalPlayer.Character
    if not gun or not char or not char:FindFirstChild("HumanoidRootPart") then return end
    if GetPlayerRole(LocalPlayer) == "Murderer" then return end
    
    IsTeleporting = true
    local hrp = char.HumanoidRootPart
    local originalCFrame = hrp.CFrame
    local gunCFrame = gun:IsA("BasePart") and gun.CFrame or (gun:FindFirstChild("Handle") and gun.Handle.CFrame)
    
    if gunCFrame then
        hrp.CFrame = gunCFrame
        task.wait(0.1)
        hrp.CFrame = originalCFrame
    end
    task.wait(0.5)
    IsTeleporting = false
end

local function GetPlayerNames()
    local names = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(names, p.Name)
        end
    end
    return names
end

-- ==========================================
-- 🪙 ระบบบินเก็บเหรียญอัตโนมัติ (Auto Coin Farm)
-- ==========================================
local function GetNearestCoin()
    local nearestCoin = nil
    local shortestDistance = math.huge
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart

    local coinContainer = nil
    for _, obj in pairs(Workspace:GetChildren()) do
        if obj:FindFirstChild("CoinContainer") then
            coinContainer = obj.CoinContainer
            break
        end
    end
    
    local searchTarget = coinContainer and coinContainer:GetChildren() or Workspace:GetDescendants()

    for _, obj in pairs(searchTarget) do
        if obj.Name == "Coin" or obj.Name == "CoinServer" or obj.Name == "Snowflake" or obj.Name == "Candy" then
            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart")
            if part and part.Transparency < 1 then
                local distance = (hrp.Position - part.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    nearestCoin = part
                end
            end
        end
    end
    return nearestCoin
end

RunService.Stepped:Connect(function()
    if AutoCoinEnabled and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait(0.05)
        if AutoCoinEnabled then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChildOfClass("Humanoid").Health > 0 then
                local hrp = char.HumanoidRootPart
                local targetCoin = GetNearestCoin()

                if targetCoin and targetCoin.Parent then
                    local bodyVelocity = hrp:FindFirstChild("CoinFarmVelocity") or Instance.new("BodyVelocity")
                    bodyVelocity.Name = "CoinFarmVelocity"
                    bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                    bodyVelocity.Parent = hrp

                    while AutoCoinEnabled and targetCoin and targetCoin.Parent and targetCoin.Transparency < 1 do
                        local direction = (targetCoin.Position - hrp.Position).Unit
                        local distance = (targetCoin.Position - hrp.Position).Magnitude

                        if distance < 3 then
                            hrp.CFrame = targetCoin.CFrame
                            task.wait(0.1)
                            break
                        else
                            bodyVelocity.Velocity = direction * (CoinFarmSpeed * 3)
                        end
                        task.wait()
                    end

                    if bodyVelocity then bodyVelocity:Destroy() end
                else
                    local bv = hrp:FindFirstChild("CoinFarmVelocity")
                    if bv then bv:Destroy() end
                end
            end
        else
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local bv = LocalPlayer.Character.HumanoidRootPart:FindFirstChild("CoinFarmVelocity")
                if bv then bv:Destroy() end
            end
        end
    end
end)

