-- 🎯 ระบบยิงฆาตกรล็อคเป้า + FOV
-- ==========================================
ShootButton.MouseButton1Click:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    
    local gun = char:FindFirstChild("Gun")
    local targetChar = GetTargetInFOV() or GetTargetInFOV()
    
    if gun and targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local murHrp = targetChar.HumanoidRootPart
        
        hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(murHrp.Position.X, hrp.Position.Y, murHrp.Position.Z))
        
        if gun:FindFirstChild("KnifeServer") and gun.KnifeServer:FindFirstChild("ShootGun") then
            gun.KnifeServer.ShootGun:FireServer(1, murHrp.Position, murHrp.CFrame)
        else
            gun:Activate()
        end
    end
end)

