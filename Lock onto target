---------------------------------------------------------
-- ระบบดูดเป้าเนียนๆ + เปลี่ยนเป้าทันทีที่สลับมุมมอง
---------------------------------------------------------
RunService.RenderStepped:Connect(function()
   if aimbotEnabled and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
      local target = getClosestTarget()
      if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
         local targetPos = target.Character.HumanoidRootPart.Position
         local currentCFrame = Camera.CFrame
         
         -- คำนวณมุมมองเป้าหมาย
         local targetCFrame = CFrame.new(currentCFrame.Position, targetPos)
         
         -- ใช้ CFrame:Lerp เพื่อให้การดูดกล้องนุ่มนวล ไม่ตุกติก ไม่หักคอทันที
         Camera.CFrame = currentCFrame:Lerp(targetCFrame, smoothAmount)
      end
   end
end)
