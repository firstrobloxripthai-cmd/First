----------------------------------------------------------------
-- ฟังก์ชันตรวจสอบชื่อสัตว์
----------------------------------------------------------------
local function IsTargetPet(name)
   if not name then return false end
   for petName, isSelected in pairs(SelectedPets) do
      if isSelected and string.find(string.lower(name), string.lower(petName)) then
         return true
      end
   end
   return false
end

----------------------------------------------------------------
-- ฟังก์ชันกรอง: ห้ามเข้าสวนคนอื่น 100%
----------------------------------------------------------------
local function IsInOtherPlayerBase(targetPart)
   local current = targetPart
   while current and current ~= workspace do
      local nameLower = string.lower(current.Name)
      if nameLower:find("plot") or nameLower:find("base") or nameLower:find("farm") or nameLower:find("house") or nameLower:find("owner") then
         return true
      end

      for _, player in pairs(game.Players:GetPlayers()) do
         if player ~= game.Players.LocalPlayer and nameLower:find(string.lower(player.Name)) then
            return true
         end
      end

      current = current.Parent
   end
   return false
end

